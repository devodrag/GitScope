# Maintainer: devodrag <devodrag@users.noreply.github.com>
# This PKGBUILD packages the prebuilt release executable. Submit it to the AUR
# as the `gitscope-bin` package; see packaging/aur/README.md for the procedure.

pkgname=gitscope-bin
pkgver=0.1.5
pkgrel=1
pkgdesc="Desktop analytics for public GitHub projects"
arch=('x86_64')
url="https://github.com/devodrag/GitScope"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1' 'sqlite' 'dbus' 'xdg-utils')
optdepends=('libnotify: desktop release notifications')
provides=('gitscope')
conflicts=('gitscope')
source=(
  "gitscope-${pkgver}::https://github.com/devodrag/GitScope/releases/download/v${pkgver}/gitscope"
  "icon-128.png::https://raw.githubusercontent.com/devodrag/GitScope/v${pkgver}/src-tauri/icons/128x128.png"
  "app.gitscope.desktop.desktop::https://raw.githubusercontent.com/devodrag/GitScope/v${pkgver}/packaging/aur/app.gitscope.desktop.desktop"
  "LICENSE::https://raw.githubusercontent.com/devodrag/GitScope/v${pkgver}/LICENSE"
)
sha256sums=(
  '481203b72abf0d30387f318e9ab0ad99a2e13e5a27514961264358214aa9696c'
  '631f3393898c0f3f5de168f84e1dca76ba2a7fcd19123d711a15ce0b3b4bc4b1'
  'SKIP'
  'SKIP'
)
options=('!strip')

package() {
  install -Dm755 "${srcdir}/gitscope-${pkgver}" "${pkgdir}/usr/bin/gitscope"
  install -Dm644 "${srcdir}/icon-128.png" \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/app.gitscope.desktop.png"
  install -Dm644 "${srcdir}/app.gitscope.desktop.desktop" \
    "${pkgdir}/usr/share/applications/app.gitscope.desktop.desktop"
  install -Dm644 "${srcdir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
